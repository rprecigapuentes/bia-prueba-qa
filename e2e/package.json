{
  "name": "energia-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright suite for the EnergIA QA technical challenge",
  "type": "commonjs",
  "scripts": {
    "setup": "npm ci && playwright install chromium firefox",
    "pretest": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:regression": "playwright test --grep @regression",
    "test:defects": "playwright test --grep @defect",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "report:allure": "allure generate ./allure-results",
    "report:allure:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.22.0",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
